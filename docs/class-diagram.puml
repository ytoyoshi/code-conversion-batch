@startuml class-diagram

!define ENTITY_COLOR #E8F5E9
!define MODEL_COLOR #E1F5FE
!define PROCESSOR_COLOR #E3F2FD
!define UTIL_COLOR #FFF3E0
!define CONSTANT_COLOR #F3E5F5

package "com.example.batch" {
    
    class EncodingBatchMain <<Main>> {
        - {static} EXIT_CODE_SUCCESS: int = 0
        - {static} EXIT_CODE_ARGS_ERROR: int = 1
        - {static} EXIT_CODE_PARAM_ERROR: int = 2
        - {static} EXIT_CODE_CONVERSION_ERROR: int = 3
        - {static} EXIT_CODE_UNEXPECTED_ERROR: int = 99
        --
        + {static} main(args: String[]): void
        - {static} execute(args: String[]): int
        - {static} executeWholeFileConversion(param: BatchParameter): void
        - {static} executeMixedFileConversion(param: BatchParameter): void
        - {static} executeVariableLengthConversion(param: BatchParameter): void
    }
    
    package "constant" CONSTANT_COLOR {
        enum FileType {
            FILE_A
            FILE_B
            FILE_C
            FILE_D
            FILE_E
            FILE_F
            --
            + {static} fromString(value: String): FileType
        }
    }
    
    package "param" ENTITY_COLOR {
        class BatchParameter {
            - {static} SUPPORTED_CHARSETS: Set<String>
            - inputFilePath: String
            - outputFilePath: String
            - sourceCharsetSingle: String
            - sourceCharsetDouble: String
            - targetCharsetSingle: String
            - targetCharsetDouble: String
            - fileId: FileType
            - convertDoubleByteCharset: boolean
            --
            + {static} load(parameterFilePath: String): BatchParameter
            - {static} getRequiredProperty(props: Properties, key: String): String
            - validateCharset(charsetName: String, paramName: String): void
            - validateSupportedCharset(charsetName: String, paramName: String): void
            - logParameters(): void
            + getInputFilePath(): String
            + getOutputFilePath(): String
            + getSourceCharsetSingle(): String
            + getSourceCharsetDouble(): String
            + getTargetCharsetSingle(): String
            + getTargetCharsetDouble(): String
            + getFileId(): FileType
            + isConvertDoubleByteCharset(): boolean
        }
    }
    
    package "model" MODEL_COLOR {
        class KanjiFieldDefinition {
            - startPos: int
            - endPos: int
            --
            + KanjiFieldDefinition(startPos: int, endPos: int)
            + getStartPos(): int
            + getEndPos(): int
        }
        
        class MixedFileConversionConfig {
            - sourceCharsetSingle: String
            - sourceCharsetDouble: String
            - targetCharsetSingle: String
            - targetCharsetDouble: String
            - convertDoubleByteCharset: boolean
            --
            + MixedFileConversionConfig(...)
            + getSourceCharsetSingle(): String
            + getSourceCharsetDouble(): String
            + getTargetCharsetSingle(): String
            + getTargetCharsetDouble(): String
            + isConvertDoubleByteCharset(): boolean
        }
    }
    
    package "processor" PROCESSOR_COLOR {
        class WholeFileConverter {
            - param: BatchParameter
            --
            + WholeFileConverter(param: BatchParameter)
            + execute(): void
            - readInputFile(): byte[]
            - writeOutputFile(outputBytes: byte[]): void
        }
        
        class MixedFileConverter {
            - param: BatchParameter
            --
            + MixedFileConverter(param: BatchParameter)
            + execute(): void
            - readInputFile(): byte[]
            - writeOutputFile(outputBytes: byte[]): void
        }
        
        class VariableLengthConverter {
            - param: BatchParameter
            --
            + VariableLengthConverter(param: BatchParameter)
            + execute(): void
            - readInputFile(): byte[]
            - writeOutputFile(outputBytes: byte[]): void
        }
    }
    
    package "util" UTIL_COLOR {
        class CodeConverter <<Utility>> {
            --
            + {static} convertCharset(data: byte[], sourceCharset: String, targetCharset: String): byte[]
            + {static} convertKanjiCharset(data: byte[], sourceCharset: String, targetCharset: String): byte[]
        }
        
        class FileConversionUtil <<Utility>> {
            - {static} WHOLE_FILE_RECORD_LENGTH: int = 210
            - {static} CODE_TYPE_POSITION: int = 5
            - {static} MIXED_FILE_RECORD_LENGTH: int = 380
            - {static} SIMPLE_RECORD_CHAR_LENGTH: int = 380
            - {static} DATA_RECORD_CHAR_LENGTH_TYPE1: int = 350
            - {static} DATA_RECORD_CHAR_LENGTH_TYPE2: int = 300
            - {static} HEADER_RECORD_TYPE: byte = '1'
            - {static} DATA_RECORD_TYPE: byte = '2'
            - {static} TRAILER_RECORD_TYPE: byte = '8'
            - {static} END_RECORD_TYPE: byte = '9'
            - {static} DATA_TYPE_1: byte = '1'
            - {static} DATA_TYPE_2: byte = '2'
            - {static} KANJI_FIELD_DEFS_CHARACTER: Map
            - {static} KANJI_FIELD_DEFS_BYTE: Map
            - {static} BDW_SIZE: int = 4
            - {static} RDW_SIZE: int = 4
            - {static} FIXED_PART_SIZE: int = 26
            - {static} MESSAGE_LEN_START: int = 30
            - {static} MESSAGE_LEN_SIZE: int = 2
            - {static} MESSAGE_START: int = 32
            - {static} TERMINATOR_SIZE: int = 1
            --
            + {static} convertWholeFile(inputBytes: byte[], sourceCharset: String, targetCharset: String): byte[]
            + {static} convertMixedFile(inputBytes: byte[], config: MixedFileConversionConfig): byte[]
            + {static} convertVariableLengthFile(inputBytes: byte[], sourceCharsetSingle: String, targetCharsetSingle: String): byte[]
            - {static} updateHeaderCodeType(data: byte[], recordLength: int, targetCharset: String): void
            - {static} convertMixedFileCharacterBased(inputBytes: byte[], config: MixedFileConversionConfig): byte[]
            - {static} convertMixedFileByteBased(inputBytes: byte[], config: MixedFileConversionConfig): byte[]
            - {static} convertSimpleRecord(data: byte[], sourceCharset: String, targetCharset: String): byte[]
            - {static} convertDataRecordCharacterBased(line: String, config: MixedFileConversionConfig): byte[]
            - {static} convertDataRecord(record: byte[], length: int, config: MixedFileConversionConfig): byte[]
            - {static} getDataRecordRemainingChars(dataType: char): int
            - {static} readFully(reader: Reader, buf: char[], len: int): int
            - {static} extractBytes(source: byte[], startPos: int, endPos: int): byte[]
            - {static} processBlock(blockData: byte[], sourceCharsetSingle: String, targetCharsetSingle: String, isToEbcdic: boolean): byte[]
            - {static} processRecord(recordData: byte[], sourceCharsetSingle: String, targetCharsetSingle: String, isToEbcdic: boolean): byte[]
            - {static} extractField(data: byte[], offset: int, length: int): byte[]
            - {static} convertControlCharacter(data: byte[], isToEbcdic: boolean): byte[]
            - {static} isTargetEbcdic(charset: String): boolean
            - {static} isUtf8(charset: String): boolean
            - {static} bytesToInt(bytes: byte[]): int
            - {static} intToBytes(value: int): byte[]
        }
    }
}

' Relationships
EncodingBatchMain ..> BatchParameter : uses
EncodingBatchMain ..> WholeFileConverter : creates
EncodingBatchMain ..> MixedFileConverter : creates
EncodingBatchMain ..> VariableLengthConverter : creates

BatchParameter --> FileType : has

WholeFileConverter --> BatchParameter : uses
WholeFileConverter ..> FileConversionUtil : calls

MixedFileConverter --> BatchParameter : uses
MixedFileConverter ..> MixedFileConversionConfig : creates
MixedFileConverter ..> FileConversionUtil : calls

VariableLengthConverter --> BatchParameter : uses
VariableLengthConverter ..> FileConversionUtil : calls

FileConversionUtil ..> MixedFileConversionConfig : uses
FileConversionUtil ..> KanjiFieldDefinition : uses
FileConversionUtil ..> CodeConverter : calls

note right of FileConversionUtil
  ファイル変換ロジックを集約した
  ユーティリティクラス。
  各Converterから呼び出される。
end note

note right of MixedFileConversionConfig
  BatchParameterに依存しない
  汎用的な変換設定クラス
end note

note right of KanjiFieldDefinition
  漢字項目の位置定義。
  UTF-8は文字位置、
  JIS/EBCDICはバイト位置として解釈
end note

@enduml
