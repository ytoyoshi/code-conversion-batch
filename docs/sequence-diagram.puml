@startuml sequence-diagram

actor User
participant "EncodingBatchMain" as Main
participant "BatchParameter" as Param
participant "WholeFileConverter\n(FILE_A/B)" as Whole
participant "MixedFileConverter\n(FILE_C/D)" as Mixed
participant "VariableLengthConverter\n(FILE_E/F)" as Variable
participant "CodeConverter" as Util

== 起動・パラメータ読み込み ==
User -> Main: java -jar xxx.jar parameter.properties
activate Main

Main -> Main: コマンドライン引数チェック
alt 引数エラー
    Main -> User: 終了コード 1
    deactivate Main
end

Main -> Param: load(parameterFilePath)
activate Param

Param -> Param: ファイル存在チェック
Param -> Param: プロパティファイル読み込み
Param -> Param: 必須パラメータチェック
Param -> Param: ファイルID妥当性チェック
Param -> Param: 文字コード妥当性チェック
Param -> Param: サポート文字コードチェック
Param -> Param: logParameters()

alt パラメータエラー
    Param --> Main: Exception
    Main -> User: 終了コード 2
    deactivate Param
    deactivate Main
end

Param --> Main: BatchParameter
deactivate Param

== ファイルタイプ判定・処理実行 ==

alt FILE_A または FILE_B
    
    Main -> Whole: new WholeFileConverter(param)
    activate Whole
    Main -> Whole: execute()
    
    Whole -> Whole: readInputFile()
    note right: ファイル全体読み込み
    
    Whole -> Util: convertCharset(bytes, srcCharset, tgtCharset)
    activate Util
    Util -> Util: 文字コード変換実行
    Util --> Whole: 変換後バイト列
    deactivate Util
    
    Whole -> Whole: writeOutputFile(outputBytes)
    note right: ファイル全体書き込み
    
    Whole --> Main: 完了
    deactivate Whole
    
else FILE_C または FILE_D
    
    Main -> Mixed: new MixedFileConverter(param)
    activate Mixed
    Main -> Mixed: execute()
    
    Mixed -> Mixed: UTF-8判定
    
    alt UTF-8の場合
        note right: 文字数ベース処理
        
        loop 各レコード（BufferedReader）
            Mixed -> Mixed: 1行読み込み (380文字)
            Mixed -> Mixed: レコード区分判定 (1文字目)
            
            alt ヘッダー/トレーラー/エンド
                Mixed -> Mixed: convertSimpleRecord()
                Mixed -> Util: convertCharset(record, srcSingle, tgtSingle)
                activate Util
                Util --> Mixed: 変換後レコード
                deactivate Util
                
            else データレコード
                Mixed -> Mixed: convertDataRecordCharacterBased()
                Mixed -> Mixed: データ種別判定 (2文字目)
                Mixed -> Mixed: 漢字項目定義取得
                
                loop 各フィールド（文字位置）
                    alt 1バイト文字フィールド
                        Mixed -> Util: convertCharset(field, srcSingle, tgtSingle)
                        activate Util
                        Util --> Mixed: 変換後フィールド
                        deactivate Util
                        
                    else 漢字フィールド
                        Mixed -> Util: convertKanjiCharset(field, srcDouble, tgtDouble)
                        activate Util
                        Util -> Util: ESCシーケンス処理
                        Util -> Util: 文字コード変換
                        Util --> Mixed: 変換後フィールド
                        deactivate Util
                    end
                end
                
                Mixed -> Mixed: 変換後レコード構築
            end
            
            Mixed -> Mixed: 出力ファイルへ書き込み
        end
        
    else UTF-8以外の場合
        note right: バイト数ベース処理
        
        loop 各レコード（InputStream）
            Mixed -> Mixed: レコード読み込み (380 bytes)
            Mixed -> Mixed: レコード区分判定 (1バイト目)
            
            alt ヘッダー/トレーラー/エンド
                Mixed -> Mixed: convertSimpleRecord()
                Mixed -> Util: convertCharset(record, srcSingle, tgtSingle)
                activate Util
                Util --> Mixed: 変換後レコード
                deactivate Util
                
            else データレコード
                Mixed -> Mixed: convertDataRecord()
                Mixed -> Mixed: データ種別判定 (2バイト目)
                Mixed -> Mixed: 漢字項目定義取得
                
                loop 各フィールド（バイト位置）
                    alt 1バイト文字フィールド
                        Mixed -> Util: convertCharset(field, srcSingle, tgtSingle)
                        activate Util
                        Util --> Mixed: 変換後フィールド
                        deactivate Util
                        
                    else 漢字フィールド
                        Mixed -> Util: convertKanjiCharset(field, srcDouble, tgtDouble)
                        activate Util
                        Util -> Util: ESCシーケンス処理
                        Util -> Util: 文字コード変換
                        Util --> Mixed: 変換後フィールド
                        deactivate Util
                    end
                end
                
                Mixed -> Mixed: 変換後レコード構築
            end
            
            Mixed -> Mixed: 出力ファイルへ書き込み
        end
    end
    
    Mixed --> Main: 完了
    deactivate Mixed
    
else FILE_E または FILE_F
    
    Main -> Variable: new VariableLengthConverter(param)
    activate Variable
    Main -> Variable: execute()
    
    loop 各ブロック
        Variable -> Variable: BDW読み込み
        Variable -> Variable: ブロックデータ読み込み
        Variable -> Variable: processRecord()
        
        Variable -> Variable: RDW、固定部、電文長、電文、終端抽出
        
        Variable -> Util: convertCharset(fixedPart, srcCharset, tgtCharset)
        activate Util
        Util --> Variable: 変換後固定部
        deactivate Util
        
        Variable -> Util: convertCharset(message, srcCharset, tgtCharset)
        activate Util
        Util --> Variable: 変換後電文
        deactivate Util
        
        Variable -> Variable: convertControlCharacter(terminator, isToEbcdic)
        note right: 内部メソッド\n0xB4 ⇔ 0x74 変換
        
        Variable -> Variable: 電文長再計算
        Variable -> Variable: RDW再計算
        Variable -> Variable: BDW再計算
        Variable -> Variable: 変換後ブロック構築
        Variable -> Variable: 出力ファイルへ書き込み
    end
    
    Variable --> Main: 完了
    deactivate Variable
    
end

== 正常終了 ==
Main -> User: 終了コード 0
deactivate Main

@enduml
