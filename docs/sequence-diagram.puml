@startuml sequence-diagram

actor User
participant "EncodingBatchMain" as Main
participant "BatchParameter" as Param
participant "WholeFileConverter\n(FILE_A/B)" as Whole
participant "MixedFileConverter\n(FILE_C/D)" as Mixed
participant "VariableLengthConverter\n(FILE_E/F)" as Variable
participant "FileConversionUtil" as FileUtil
participant "CodeConverter" as Util

== 起動・パラメータ読み込み ==
User -> Main: java -jar xxx.jar parameter.properties
activate Main

Main -> Main: コマンドライン引数チェック
alt 引数エラー
    Main -> User: 終了コード 1
    deactivate Main
end

Main -> Param: load(parameterFilePath)
activate Param

Param -> Param: ファイル存在チェック
Param -> Param: プロパティファイル読み込み
Param -> Param: 必須パラメータチェック
Param -> Param: ファイルID妥当性チェック
Param -> Param: 2バイト文字コード条件付きチェック\n(FILE_C/D時のみ必須)
Param -> Param: 文字コード妥当性チェック
Param -> Param: サポート文字コードチェック
Param -> Param: 漢字変換フラグ設定\n(convertDoubleByteCharset)
Param -> Param: logParameters()

alt パラメータエラー
    Param --> Main: Exception
    Main -> User: 終了コード 2
    deactivate Param
    deactivate Main
end

Param --> Main: BatchParameter
deactivate Param

== ファイルタイプ判定・処理実行 ==

alt FILE_A または FILE_B
    
    Main -> Whole: new WholeFileConverter(param)
    activate Whole
    Main -> Whole: execute()
    
    Whole -> Whole: readInputFile()
    note right: Files.readAllBytes()
    
    Whole -> FileUtil: convertWholeFile(inputBytes, sourceCharset, targetCharset)
    activate FileUtil
    
    FileUtil -> Util: convertCharset(inputBytes, sourceCharset, targetCharset)
    activate Util
    Util --> FileUtil: 変換後バイト配列
    deactivate Util
    
    FileUtil -> FileUtil: updateHeaderCodeType(data, 210, targetCharset)
    note right: ヘッダーレコードの\nコード区分を更新
    
    FileUtil --> Whole: 変換後バイト配列
    deactivate FileUtil
    
    Whole -> Whole: writeOutputFile(outputBytes)
    note right: Files.write()
    
    Whole --> Main: 完了
    deactivate Whole
    
else FILE_C または FILE_D
    
    Main -> Mixed: new MixedFileConverter(param)
    activate Mixed
    Main -> Mixed: execute()
    
    Mixed -> Mixed: readInputFile()
    note right: Files.readAllBytes()
    
    Mixed -> Mixed: new MixedFileConversionConfig(...)
    note right: BatchParameterから\n設定オブジェクトを作成
    
    Mixed -> FileUtil: convertMixedFile(inputBytes, config)
    activate FileUtil
    
    FileUtil -> FileUtil: isUtf8(sourceCharsetSingle)
    
    alt UTF-8の場合
        FileUtil -> FileUtil: convertMixedFileCharacterBased(inputBytes, config)
        note right: 文字数ベース処理\n(先読み方式)
        
        loop 各レコード
            FileUtil -> FileUtil: レコード区分先読み
            
            alt データレコード
                FileUtil -> FileUtil: データ種別先読み
                FileUtil -> FileUtil: 残り文字数決定\n(種別=1: 348文字\n種別=2: 298文字)
                FileUtil -> FileUtil: readFully()
                FileUtil -> FileUtil: convertDataRecordCharacterBased()
                
                loop 各フィールド
                    alt 1バイト文字
                        FileUtil -> Util: convertCharset()
                        activate Util
                        Util --> FileUtil
                        deactivate Util
                    else 漢字フィールド
                        alt convertDoubleByteCharset == true
                            FileUtil -> Util: convertKanjiCharset()
                            activate Util
                            Util --> FileUtil
                            deactivate Util
                        else
                            FileUtil -> FileUtil: そのまま出力
                        end
                    end
                end
                
            else ヘッダー/トレーラー/エンド
                FileUtil -> FileUtil: 残り379文字読み込み
                FileUtil -> FileUtil: convertSimpleRecord()
                FileUtil -> Util: convertCharset()
                activate Util
                Util --> FileUtil
                deactivate Util
                FileUtil -> FileUtil: ヘッダーなら\nコード区分更新
            end
        end
        
    else UTF-8以外
        FileUtil -> FileUtil: convertMixedFileByteBased(inputBytes, config)
        note right: バイト数ベース処理
        
        loop 各レコード(380バイト)
            alt データレコード
                FileUtil -> FileUtil: convertDataRecord()
                
                loop 各フィールド
                    alt 1バイト文字
                        FileUtil -> Util: convertCharset()
                        activate Util
                        Util --> FileUtil
                        deactivate Util
                    else 漢字フィールド
                        alt convertDoubleByteCharset == true
                            FileUtil -> Util: convertKanjiCharset()
                            activate Util
                            Util --> FileUtil
                            deactivate Util
                        else
                            FileUtil -> FileUtil: そのまま出力
                        end
                    end
                end
                
            else ヘッダー/トレーラー/エンド
                FileUtil -> FileUtil: convertSimpleRecord()
                FileUtil -> Util: convertCharset()
                activate Util
                Util --> FileUtil
                deactivate Util
                FileUtil -> FileUtil: ヘッダーなら\nコード区分更新
            end
        end
    end
    
    FileUtil --> Mixed: 変換後バイト配列
    deactivate FileUtil
    
    Mixed -> Mixed: writeOutputFile(outputBytes)
    note right: Files.write()
    
    Mixed --> Main: 完了
    deactivate Mixed
    
else FILE_E または FILE_F
    
    Main -> Variable: new VariableLengthConverter(param)
    activate Variable
    Main -> Variable: execute()
    
    Variable -> Variable: readInputFile()
    note right: Files.readAllBytes()
    
    Variable -> FileUtil: convertVariableLengthFile(inputBytes, sourceCharsetSingle, targetCharsetSingle)
    activate FileUtil
    
    FileUtil -> FileUtil: isTargetEbcdic(targetCharsetSingle)
    
    loop 各ブロック
        FileUtil -> FileUtil: BDW読み込み
        FileUtil -> FileUtil: processBlock()
        
        FileUtil -> FileUtil: processRecord()
        
        FileUtil -> FileUtil: 固定部抽出
        FileUtil -> Util: convertCharset(固定部)
        activate Util
        Util --> FileUtil
        deactivate Util
        
        FileUtil -> FileUtil: 電文長・電文抽出
        FileUtil -> Util: convertCharset(電文)
        activate Util
        Util --> FileUtil
        deactivate Util
        
        FileUtil -> FileUtil: 終端符号抽出
        FileUtil -> FileUtil: convertControlCharacter(終端符号, isToEbcdic)
        note right: 0xB4 ⇔ 0x74 変換
        
        FileUtil -> FileUtil: 新しい電文長計算
        FileUtil -> FileUtil: 新しいRDW計算
        FileUtil -> FileUtil: レコード再構築
        
        FileUtil -> FileUtil: 新しいBDW計算
        FileUtil -> FileUtil: ブロック再構築
    end
    
    FileUtil --> Variable: 変換後バイト配列
    deactivate FileUtil
    
    Variable -> Variable: writeOutputFile(outputBytes)
    note right: Files.write()
    
    Variable --> Main: 完了
    deactivate Variable
    
end

Main -> User: 終了コード 0
deactivate Main

@enduml
